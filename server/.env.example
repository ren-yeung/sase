# ===== OgCloud 原型 · 大模型配置 =====
# 用法：把本文件复制为同目录下的 .env，填入你自己的值后重启服务（node server/server.js）
# 注意：.env 只在本地服务端读取，永远不会发送到浏览器。请勿把真实 key 提交到任何仓库。

# 1) API Key（必填）—— 你所用模型服务商的密钥
LLM_API_KEY=

# 2) 接口地址（必填）—— 各家大模型都兼容 OpenAI /chat/completions 协议，换模型只改这里
#   通义千问 Qwen：  https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek：       https://api.deepseek.com/v1
#   智谱 GLM：       https://open.bigmodel.cn/api/paas/v4
#   OpenAI：        https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 3) 模型名（必填）
#   通义千问：  qwen-plus   / qwen-max   / qwen-turbo
#   DeepSeek：  deepseek-v4-pro   / deepseek-v4-flash   / deepseek-chat
#   智谱 GLM：  glm-4   / glm-4-flash
#   OpenAI：    gpt-4o-mini  / gpt-4o
LLM_MODEL=qwen-plus

# 4) 超时（可选，毫秒，默认 90000）
LLM_TIMEOUT=90000

# 5) 代理（可选）—— 如果在公司内网，Node 不会自动走系统代理，可在此填写
#   例如：http://proxy.company.com:8080  或  http://127.0.0.1:7890
#   留空则优先读取系统环境变量 HTTPS_PROXY / HTTP_PROXY
LLM_PROXY=

# 6) 端口（可选，默认 4173）
PORT=4173
